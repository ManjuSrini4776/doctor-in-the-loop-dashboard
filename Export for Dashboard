import pandas as pd
import os

# ── STEP 1: Search for your fusion file
search_paths = [
    "/content/drive/MyDrive/Medical_AI_Project",
    "/content/drive/MyDrive/MIMIC_DOCTOR_IN_LOOP_PROJECT",
    "/content/drive/MyDrive/"
]
print("Searching for fusion data...\n")
for base in search_paths:
    if os.path.exists(base):
        for root, dirs, files in os.walk(base):
            for f in files:
                if any(kw in f.lower() for kw in
                       ["fusion","patient","severity","context","multimodal"]):
                    full = os.path.join(root, f)
                    size = os.path.getsize(full)/1e6
                    print(f"  Found: {full}  ({size:.1f} MB)")

# ── STEP 2: Load (replace path with what Step 1 found)
fusion_path = "PASTE_YOUR_PATH_HERE"
df = pd.read_parquet(fusion_path) if fusion_path.endswith(".parquet") \
     else pd.read_csv(fusion_path)
print(f"\nShape: {df.shape}")
print("Columns:", df.columns.tolist())

# ── STEP 3: Standardise columns
col_map = {}
for c in df.columns:
    cl = c.lower()
    if "hadm" in cl or ("case" in cl and "id" in cl): col_map[c] = "case_id"
    elif "lab" in cl and "score" in cl:               col_map[c] = "lab_score"
    elif "ct" in cl and "score" in cl:                col_map[c] = "ct_score"
    elif "ct" in cl and "dis" in cl:                  col_map[c] = "ct_disease"
    elif ("ultra" in cl or "us" in cl) and "score" in cl: col_map[c] = "ultrasound_score"
    elif ("ultra" in cl or "us" in cl) and "dis" in cl:   col_map[c] = "ultrasound_disease"
    elif "fusion" in cl and "score" in cl:            col_map[c] = "fusion_score"
    elif "final" in cl and "sev" in cl:               col_map[c] = "final_severity"
    elif "predict" in cl and "class" in cl:           col_map[c] = "ct_disease"
df = df.rename(columns=col_map)

# ── STEP 4: Add severity label if missing
def severity_label(score):
    if pd.isna(score): return "Unknown"
    elif score < 0.5: return "Normal"
    elif score < 1.5: return "Mild"
    elif score < 2.5: return "Moderate"
    else: return "Severe"

if "final_severity" not in df.columns and "fusion_score" in df.columns:
    df["final_severity"] = df["fusion_score"].apply(severity_label)

# ── STEP 5: Filter — keep Severe + Moderate only for dashboard
#            (these are the patients who need doctor review)
keep_cols = [c for c in ["case_id","lab_score","ct_score","ct_disease",
                          "ultrasound_score","ultrasound_disease",
                          "fusion_score","final_severity"] if c in df.columns]
df = df[keep_cols].copy()
df = df[df[["lab_score","ct_score","ultrasound_score"]].notna().any(axis=1)]
df["case_id"] = df["case_id"].astype(str)
df = df.drop_duplicates(subset=["case_id"])

dashboard_df = df[df["final_severity"].isin(["Severe","Moderate","Mild"])]
print(f"\nDashboard patients: {len(dashboard_df)}")
print(dashboard_df["final_severity"].value_counts())
print(dashboard_df.head())

# ── STEP 6: Save
save_path = "/content/drive/MyDrive/Medical_AI_Project/outputs/fusion_patient_context.csv"
dashboard_df.to_csv(save_path, index=False)
size = os.path.getsize(save_path)/1e6
print(f"\n✅ Saved {len(dashboard_df)} patients → {save_path}")
print(f"   File size: {size:.1f} MB")
print("\nUpload this file to your GitHub repo at: data/fusion_patient_context.csv")
